{
    "compilerOptions": {
        "target": "ES2024",
        "lib": [
            "dom",
            "dom.iterable",
            "ES2024"
        ],
        "allowJs": false,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "noUncheckedIndexedAccess": false,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "next.config.ts",
        "vitest.config.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
