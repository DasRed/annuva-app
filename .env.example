# Annuva – configuration. Every value is optional; the defaults start a single-tenant instance
# with SQLite in ./data. Copy to .env and adjust.

# single = self-hosted with setup wizard, multi = several tenants with self-registration (prepared)
APP_MODE=single
APP_NAME=Annuva
# Only needed for absolute links without a request (e-mails sent by background jobs).
# Otherwise the URL is taken from the request / X-Forwarded-Host.
APP_URL=

# Listen address and port (read by the Next.js server)
HOSTNAME=0.0.0.0
PORT=40100

# Everything on disk lives here: SQLite database, uploaded files, invoice PDFs, generated secrets.
DATA_DIR=./data

# Database: sqlite (default), mysql or postgres
DB_DRIVER=sqlite
DB_SQLITE_FILE=annuva.sqlite
DB_HOST=localhost
DB_PORT=
DB_NAME=annuva
DB_USER=annuva
DB_PASSWORD=
# Alternatively a connection URL (mysql://… or postgres://…)
DATABASE_URL=

# Generated on first start and stored in DATA_DIR when empty.
AUTH_SECRET=
# Protects the setup wizard. Generated and printed to the log when empty.
SETUP_TOKEN=
SESSION_MAX_AGE_DAYS=30

# System e-mail (password reset, invoices, reminders). Without SMTP_HOST no mails are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

GRAVATAR_ENABLED=true
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Europe/Berlin
UPLOAD_MAX_SIZE=20MB
LOG_LEVEL=info
